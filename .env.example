# ── CC Toolkit — deployment config ───────────────────────────────────────
# Copy to `.env` and edit values. ./up.sh reads this automatically.

# Flask secret for the web dashboard (set a long random value).
CC_SECRET=change-me-in-production

# JupyterLab token. Empty = no auth token (dev only). Set a strong value
# for any public-facing deployment.
CC_JUPYTER_TOKEN=change-me-or-empty

# EDR server secrets (HMAC for ingest + admin API key for the dashboard).
EDR_SECRET_KEY=change-me-edr-secret
EDR_ADMIN_API_KEY=change-me-edr-admin-key

# ── Networking / reverse-proxy (Phase 0-1) ────────────────────────────────
# Shared network for the stack + nginx-proxy-manager/wg-easy (edges/).
# ./up.sh creates it if it doesn't exist.
CC_NETNAME=cc-net

# Public base domain of the reverse proxy, once provisioned (Phase 1).
# Example: CC_DOMAIN=cc.example.com
CC_DOMAIN=

# Service URLs the dashboard reaches. Defaults are in-container names on
# cc-net. In the reverse-proxy layout you may point browser-facing ones at
# the public https URL, e.g.:
#   CC_JUPYTER_URL=https://cc.example.com/jupyter
#   CC_CAIDO_URL=http://caido:8080            # keep caido NON-public
#   EDR_SERVER_URL=http://edr:8900            # keep internal (agents use wg)
# CC_JUPYTER_URL=
# CC_CAIDO_URL=
# EDR_SERVER_URL=

# Jupyter reverse-proxy base path (empty = root). Set to /jupyter when the
# proxy routes that path (Phase 1).
JUPYTER_BASE_URL=

# ── Service enable/disable flags ───────────────────────────────────────────
# up.sh only starts services whose flag is "1". Setting any to "0" disables
# it without touching docker-compose.yml.
CC_ENABLE_JUPYTER=1
CC_ENABLE_CAIDO=1
CC_ENABLE_EDR=1