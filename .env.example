# ── CC Toolkit Environment Configuration ──────────────────────────────────
# Copy this file to .env and customize for your environment.
# All settings are optional — sensible defaults are used when unset.
# ──────────────────────────────────────────────────────────────────────────

# Workspace root (all data lives here)
CC_WORKSPACE=/workspace

# Web dashboard
CC_HOST=0.0.0.0
CC_PORT=5000
CC_API_KEY=
CC_SECRET=change-me-to-a-random-string
CC_DEBUG=false

# WebSocket terminal port (dashboard port + 1 by default)
CC_WS_PORT=5001

# External services
CC_JUPYTER_URL=http://localhost:8888
  #   Docker: use http://jupyter:8888 with the with-jupyter profile
CC_CAIDO_URL=http://localhost:8080
  #   Docker: http://host.docker.internal:8080 (Caido on host, default)
  #   Docker: http://caido:8080 (Caido in container, with-caido profile)
CC_KALI_SSH=     # e.g. root@kali.local — leave empty to disable

# Report branding
CC_COMPANY=Your Company Name
CC_TESTER=Your Name
CC_LOGO_RELPATH=  # path to logo image for reports

# Obsidian vault path (for report auto-export)
CC_OBSIDIAN_DIR=  # path to your Obsidian vault
CC_OBSIDIAN_OUTPUT_SUBDIR=Command Center

# Tool and data directories
CC_TOOLS_DIR=     # defaults to {workspace}/tools
CC_PENTEST_DIR=   # defaults to {workspace}/cases
CC_WORDLISTS_DIR= # defaults to {workspace}/wordlists
CC_LOGS_DIR=      # defaults to {workspace}/logs
CC_SESSIONS_DIR=  # defaults to {workspace}/sessions

# Credential vault (auto-generated on first run if empty)
CC_VAULT_SECRET=

# JSON config file (overrides env vars)
CC_CONFIG_FILE=   # defaults to {workspace}/config/settings.json
